
@page "/"

<PageTitle>Domov | Evidencia zamestnancov</PageTitle>

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">Evidencia zamestnancov</h1>

        <p class="lead text-muted mt-3">
            Jednoduchá správa zamestnancov a ich pracovných pozícií
            na jednom mieste.
        </p>
    </div>

    <div class="row justify-content-center g-4">
        <div class="col-md-5 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center p-4">
                    <h2 class="h4 mb-3">Zamestnanci</h2>

                    <p class="text-muted">
                        Zobraz zoznam zamestnancov, pozri si ich údaje,
                        uprav existujúce záznamy alebo odstráň zamestnanca
                        z evidencie.
                    </p>

                    <a href="employees" class="btn btn-primary mt-2">
                        Zobraziť zamestnancov
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-5 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center p-4">
                    <h2 class="h4 mb-3">Nový zamestnanec</h2>

                    <p class="text-muted">
                        Pridaj nového zamestnanca do databázy a vyplň
                        jeho osobné údaje, pracovnú pozíciu a IP adresu.
                    </p>

                    <a href="employees/add" class="btn btn-success mt-2">
                        Pridať zamestnanca
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-5">
        <p class="text-muted small">
            Aplikácia na evidenciu zamestnancov a správu pracovných pozícií.
        </p>
    </div>
</div>
