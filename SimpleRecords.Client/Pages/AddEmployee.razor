@page "/employees/add"
@using System.Net
@using SimpleRecords.Client.Models
@inject HttpClient Http

<PageTitle>Pridať zamestnanca</PageTitle>

<h1>Pridať zamestnanca</h1>

@if (positions == null)
{
    <p>Načítavam pracovné pozície...</p>
}
else if (positions.Length == 0)
{
    <p>V databáze nie sú žiadne pracovné pozície.</p>
}
else
{
    <EditForm Model="employee" OnValidSubmit="SaveEmployee">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Meno</label>
            <InputText class="form-control"
                       @bind-Value="employee.Name" />
        </div>

        <div class="mb-3">
            <label class="form-label">Priezvisko</label>
            <InputText class="form-control"
                       @bind-Value="employee.Surname" />
        </div>

        <div class="mb-3">
            <label class="form-label">Dátum narodenia</label>
            <InputDate class="form-control"
                       @bind-Value="employee.BirthDate" />
        </div>

        <div class="mb-3">
            <label class="form-label">Pracovná pozícia</label>
            <InputSelect class="form-select"
                         @bind-Value="employee.PositionID">
                <option value="">Vyber pozíciu</option>
                @foreach (var position in positions)
                {
                    <option value="@position.PositionID">
                        @position.PositionName
                    </option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">IP adresa</label>
            <InputText class="form-control"
                       @bind-Value="employee.IPaddress" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@isSaving">
            @(isSaving ? "Ukladám..." : "Pridať zamestnanca")
        </button>
    </EditForm>
}

@if (!string.IsNullOrWhiteSpace(message))
{
    <p class="mt-3">@message</p>
}

@code {
    private Position[]? positions;
    private string message = string.Empty;

    private Employee employee = new();

    protected override async Task OnInitializedAsync()
    {
        positions = await Http.GetFromJsonAsync<Position[]>(
            "api/positions");
    }

    private bool isSaving;

    private async Task SaveEmployee()
    {
        message = string.Empty;

        if (!IsValidPersonName(employee.Name))
        {
            message = "Meno obsahuje nepovolené znaky.";
            return;
        }

        if (!IsValidPersonName(employee.Surname))
        {
            message = "Priezvisko obsahuje nepovolené znaky.";
            return;
        }

        if (employee.BirthDate is null)
        {
            message = "Zadaj dátum narodenia.";
            return;
        }

        if (employee.BirthDate.Value.Date > DateTime.Today)
        {
            message = "Dátum narodenia nemôže byť v budúcnosti.";
            return;
        }

        if (string.IsNullOrWhiteSpace(employee.Name) || string.IsNullOrWhiteSpace(employee.Surname) ||
            string.IsNullOrWhiteSpace(employee.IPaddress) || employee.PositionID is null)
        {
            message = "Vyplň všetky povinné polia.";
            return;
        }


        if (!IPAddress.TryParse(employee.IPaddress.Trim(), out _))
        {
            message = "Zadaj platnú IP adresu, napríklad 8.8.8.8 alebo 2001:4860:4860::8888.";
            return;
        }

        isSaving = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/employees", employee);

            if (response.IsSuccessStatusCode)
            {
                message = "Zamestnanec bol úspešne pridaný.";

                employee = new Employee();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();

                message = $"Zamestnanca sa nepodarilo uložiť. {error}";
            }
        }
        catch (HttpRequestException)
        {
            message = "Nepodarilo sa spojiť so serverom. Skontroluj, či server beží.";
        }
        catch (Exception)
        {
            message = "Pri ukladaní nastala neočakávaná chyba.";
        }
        finally
        {
            isSaving = false;
        }
    }


    private bool IsValidPersonName(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        bool hasLetter = false;

        foreach (char character in value.Trim())
        {
            if (char.IsLetter(character))
            {
                hasLetter = true;
            }
            else if (character != ' ' &&
                    character != '-' &&
                    character != '\'' &&
                    character != '’')
            {
                return false;
            }
        }

        return hasLetter;
    }


}
